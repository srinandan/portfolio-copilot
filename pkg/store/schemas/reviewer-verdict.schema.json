{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-copilot/schemas/reviewer-verdict.schema.json",
  "title": "ReviewerVerdict",
  "description": "Output of the Reviewer/Critic. Itemized per-rule so a specific catch (e.g. the adversarial-test scenario) can be pointed to directly, not just an overall pass/fail.",
  "type": "object",
  "required": [
    "verdict_id",
    "action_id",
    "ips_version_checked_against",
    "rule_results",
    "overall_pass",
    "requires_human_approval",
    "reviewer_skill_version",
    "reviewed_at"
  ],
  "properties": {
    "verdict_id": { "type": "string" },
    "action_id": {
      "type": "string",
      "description": "The ProposedAction.action_id this verdict was produced for."
    },
    "ips_version_checked_against": {
      "type": "object",
      "required": ["ips_id", "version"],
      "properties": {
        "ips_id": { "type": "string" },
        "version": { "type": "integer" }
      }
    },

    "rule_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "description", "passed"],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "e.g. 'excluded-ticker', 'concentration-limit', 'allocation-band', 'order-size-sanity', 'ips-version-current'."
          },
          "description": { "type": "string" },
          "passed": { "type": "boolean" },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation, especially important on failure."
          }
        }
      }
    },

    "overall_pass": {
      "type": "boolean",
      "description": "True only if every rule in rule_results passed."
    },
    "requires_human_approval": {
      "type": "boolean",
      "description": "Can be true even when overall_pass is true — the IPS's own approval thresholds (approval_required_above_usd / _percent) are independent of rule compliance."
    },

    "reviewer_skill_version": {
      "type": "object",
      "required": ["skill_name", "skill_version"],
      "properties": {
        "skill_name": { "type": "string" },
        "skill_version": { "type": "string" },
        "registry_entry_id": { "type": "string" }
      }
    },

    "reviewed_at": { "type": "string", "format": "date-time" }
  }
}
