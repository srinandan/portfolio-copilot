{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio-copilot/schemas/ips.schema.json",
  "title": "InvestmentPolicyStatement",
  "description": "The reference plan produced by Goals & Onboarding. Append-only: a change creates a new version rather than editing in place.",
  "type": "object",
  "required": [
    "ips_id",
    "user_id",
    "version",
    "status",
    "effective_date",
    "risk_tolerance",
    "time_horizon_years",
    "target_allocation",
    "constraints",
    "created_at"
  ],
  "properties": {
    "ips_id": {
      "type": "string",
      "description": "Stable identifier shared across all versions of one user's IPS."
    },
    "user_id": { "type": "string" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented on every revision. Never mutate an existing version's fields."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "superseded"]
    },
    "superseded_by": {
      "type": ["string", "null"],
      "description": "ips_id + version of the record that replaced this one, if status is 'superseded'."
    },
    "effective_date": { "type": "string", "format": "date" },

    "risk_tolerance": {
      "type": "string",
      "enum": ["conservative", "moderate", "aggressive"]
    },
    "time_horizon_years": { "type": "integer", "minimum": 0 },

    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "target_amount_usd", "target_date"],
        "properties": {
          "name": { "type": "string" },
          "target_amount_usd": { "type": "number", "minimum": 0 },
          "target_date": { "type": "string", "format": "date" }
        }
      }
    },

    "liquidity_needs": {
      "type": "object",
      "properties": {
        "reserve_months": { "type": "number", "minimum": 0 },
        "known_upcoming_expenses_usd": { "type": "number", "minimum": 0 }
      }
    },

    "target_allocation": {
      "type": "array",
      "description": "Bands, not point targets — this is what Portfolio Analysis measures drift against.",
      "items": {
        "type": "object",
        "required": ["asset_class", "target_percent", "min_percent", "max_percent"],
        "properties": {
          "asset_class": { "type": "string" },
          "target_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "min_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "max_percent": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },

    "constraints": {
      "type": "object",
      "required": ["concentration_limit_percent"],
      "properties": {
        "excluded_tickers": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "excluded_sectors": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "concentration_limit_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Max percent of portfolio value any single position may represent."
        },
        "tax_loss_harvesting_enabled": { "type": "boolean", "default": false },
        "account_type": {
          "type": "string",
          "enum": ["taxable", "retirement"]
        }
      }
    },

    "rebalancing_rules": {
      "type": "object",
      "properties": {
        "trigger_type": {
          "type": "string",
          "enum": ["threshold", "calendar", "both"]
        },
        "drift_threshold_percent": { "type": "number", "minimum": 0 },
        "rebalancing_frequency_days": { "type": "integer", "minimum": 1 }
      }
    },

    "approval_required_above_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Any proposed action valued above this always requires human approval, regardless of Reviewer verdict."
    },
    "approval_required_above_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Same, expressed as percent of total portfolio value."
    },

    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
