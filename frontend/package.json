    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
